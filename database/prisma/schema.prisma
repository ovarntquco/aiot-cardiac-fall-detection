generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model alerts {
  id       String @id @db.Char(10)
  event_id String @db.Char(10)
  status   String @db.VarChar(255)
  details  String
  events   events @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "alerts_event_id_foreign")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model devices {
  id              String            @id @db.Char(10)
  patient_id      String            @db.Char(10)
  status          String            @db.VarChar(255)
  patients        patients          @relation(fields: [patient_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "devices_patient_id_foreign")
  gps_readings    gps_readings[]
  sensor_readings sensor_readings[]

  @@index([patient_id], map: "devices_patient_id_index")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model events {
  id                String          @id @db.Char(10)
  type              String          @db.VarChar(255)
  sensor_reading_id String          @db.Char(10)
  gps_reading_id    String          @db.Char(10)
  alerts            alerts[]
  gps_readings      gps_readings    @relation(fields: [gps_reading_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "events_gps_reading_id_foreign")
  sensor_readings   sensor_readings @relation(fields: [sensor_reading_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "events_sensor_reading_id_foreign")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model gps_readings {
  id          String   @id @db.Char(10)
  device_id   String   @db.Char(10)
  latitude    Decimal  @db.Decimal(8, 2)
  longitude   Decimal  @db.Decimal(8, 2)
  recorded_at DateTime @db.Timestamp(0)
  events      events[]
  devices     devices  @relation(fields: [device_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "gps_readings_device_id_foreign")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model patients {
  user_id                                    String    @id @db.Char(10)
  full_name                                  String    @db.VarChar(255)
  date_of_birth                              DateTime  @db.Date
  sex                                        String    @db.VarChar(255)
  height                                     Decimal   @db.Decimal(5, 2)
  weight                                     Decimal   @db.Decimal(5, 2)
  setting_id                                 String    @db.Char(10)
  primary_caregiver_id                       String    @db.Char(10)
  devices                                    devices[]
  users_patients_primary_caregiver_idTousers users     @relation("patients_primary_caregiver_idTousers", fields: [primary_caregiver_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "patients_primary_caregiver_id_foreign")
  settings                                   settings  @relation(fields: [setting_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "patients_setting_id_foreign")
  users_patients_user_idTousers              users     @relation("patients_user_idTousers", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "patients_user_id_foreign")

  @@index([primary_caregiver_id], map: "patients_primary_caregiver_id_index")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model sensor_readings {
  id            String   @id @db.Char(10)
  device_id     String   @db.Char(10)
  type          String   @db.VarChar(255)
  value_numeric Float?
  value_vector  Json?
  unit          String?  @db.VarChar(255)
  recorded_at   DateTime @db.Timestamp(0)
  events        events[]
  devices       devices  @relation(fields: [device_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "sensor_readings_device_id_foreign")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model settings {
  id        String     @id @db.Char(10)
  hr_high   Int
  hr_low    Int
  spo2_high Int
  chat_id   String     @db.VarChar(255)
  patients  patients[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id                                            String     @id @db.Char(10)
  email                                         String     @unique(map: "users_email_unique") @db.VarChar(255)
  password                                      String     @db.VarChar(255)
  role                                          String     @db.VarChar(255)
  patients_patients_primary_caregiver_idTousers patients[] @relation("patients_primary_caregiver_idTousers")
  patients_patients_user_idTousers              patients?  @relation("patients_user_idTousers")

  @@index([email], map: "users_email_index")
  @@index([role], map: "users_role_index")
}
